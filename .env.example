# The site. Use the POOLED Neon endpoint — its host contains "-pooler".
# src/db/index.ts sets `prepare: false` for it, which PgBouncer requires.
DATABASE_URL=postgres://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require

# The ingestion scripts and compute:versus. Use the DIRECT endpoint, without
# "-pooler". They do bulk writes and gain from prepared statements.
DIRECT_DATABASE_URL=postgres://user:password@host.region.aws.neon.tech/dbname?sslmode=require

# A local database needs neither the pooler nor TLS:
# DATABASE_URL=postgres://user:password@localhost:5432/hockey_versus

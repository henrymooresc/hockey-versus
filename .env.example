# The site. Use the POOLED Neon endpoint — its host contains "-pooler".
# src/db/index.ts sets `prepare: false` for it, which PgBouncer requires.
DATABASE_URL=postgres://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require

# The ingestion scripts and compute:versus. Use the DIRECT endpoint, without
# "-pooler". They do bulk writes and gain from prepared statements.
DIRECT_DATABASE_URL=postgres://user:password@host.region.aws.neon.tech/dbname?sslmode=require

# A local database needs neither the pooler nor TLS:
# DATABASE_URL=postgres://user:password@localhost:5432/hockey_versus

# Error reporting. All of it is optional: with no DSN the Sentry SDK is inert,
# next.config.ts exports an unwrapped config, and nothing is sent. Reporting is
# additionally limited to VERCEL_ENV=production, so local runs stay quiet even
# when a DSN is present.
#
# The DSN is not a secret. It only permits sending events, which is why Sentry
# expects it in a NEXT_PUBLIC_ variable that ships to the browser.
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project-id>

# Only needed to upload source maps, which turn a minified production stack
# trace back into real file names. SENTRY_AUTH_TOKEN *is* a secret. Without
# these three the build still succeeds.
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=hockey-versus
# SENTRY_AUTH_TOKEN=sntrys_...

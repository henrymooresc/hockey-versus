# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
# Ignore every .env variant, then re-admit the committed template. The old
# rules covered only `.env` and `.env*.local`, so a file named `.env.neon` or
# `.env.production` holding real credentials would have been committed.
.env*
*.env
!.env.example

# database dumps — these hold the whole dataset
*.dump
*.sql.gz

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# drizzle
# NOTE: drizzle/meta is tracked on purpose. `drizzle-kit migrate` reads
# meta/_journal.json, so a fresh clone cannot set up the database without it.

# Claude
/.claude